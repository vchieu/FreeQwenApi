{
  "manifest_version": 3,
  "name": "Qwen Session Sync",
  "version": "1.0",
  "description": "Pushes fresh Qwen tokens and Baxia WAF headers from real UI traffic to the local FreeQwenApi proxy.",
  "permissions": [
    "webRequest",
    "storage",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "https://chat.qwen.ai/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chat.qwen.ai/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Qwen Session Sync",
    "default_popup": "popup.html"
  }
}
